# Local provider keys for development. Copy to dev_secrets.env, which is
# ignored by git, and fill in your own.
#
#   cp dev_secrets.example.env dev_secrets.env
#   ./tool/run-dev.sh -d linux
#
# Never commit dev_secrets.env, and never put a key in any other file: a
# credential in the repository is a credential in every built artifact
# (Vision.md 34, 80).

# Alpha Vantage. Prices for German and other non-US listings.
# Claim one free at https://www.alphavantage.co/support/#api-key -- it asks for
# an email address and appears on the page in under a minute.
#
# `demo` is Alpha Vantage's own published demo key. It answers for a handful of
# US symbols such as IBM and refuses everything else, so it is enough to see
# the quote path working end to end without an account, and not enough to price
# a real portfolio.
ALPHA_VANTAGE_API_KEY=demo

# Finnhub. Prices for US listings, paced per second rather than capped per day.
# Register at https://finnhub.io/register; the key is on the dashboard.
# Their free plan is for personal use only -- see docs/data-providers.md.
FINNHUB_API_KEY=
